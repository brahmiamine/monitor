# À copier vers /etc/monitor.env (sudo install -m 0640 -o root -g monitor deploy/monitor.env.example /etc/monitor.env).
# Tout est facultatif : sans ce fichier, Monitor utilise SQLite et s'adapte à n'importe quel nom de domaine.

# Nom affiché dans l'interface (par défaut : nom d'hôte du serveur).
#MONITOR_NAME=Mon serveur
# Adresse publique (alertes, contrôle d'origine). Vide : l'origine doit correspondre à l'hôte demandé.
#MONITOR_ORIGIN=https://monitor.exemple.fr

# Base de données : SQLite par défaut ; MariaDB / MySQL (le serveur de base peut être local, par socket ou par TCP) :
#MONITOR_DB=mysql://monitor:motdepasse@localhost/monitor?socket=/run/mysqld/mysqld.sock
# Reprise unique des données d'une ancienne base SQLite lors du passage à MariaDB :
#MONITOR_MIGRATE_FROM=/var/lib/monitor/monitor.db

# Dossier des fichiers {sha, at} écrits par le déploiement automatique (dernier déploiement de chaque projet).
#MONITOR_DEPLOY_STATE=/opt/monitor/deploy-state
